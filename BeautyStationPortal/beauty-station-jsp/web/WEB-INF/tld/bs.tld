<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://xmlns.jcp.org/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">
  <description>Funciones de formato de Beauty Station</description>
  <tlib-version>1.0</tlib-version>
  <short-name>bs</short-name>
  <uri>https://beautystation.com/funciones</uri>

  <function>
    <description>$1,359.00</description>
    <name>money</name>
    <function-class>com.beautystation.util.Fmt</function-class>
    <function-signature>java.lang.String money(double)</function-signature>
  </function>
  <function>
    <description>$2,000</description>
    <name>money0</name>
    <function-class>com.beautystation.util.Fmt</function-class>
    <function-signature>java.lang.String money0(double)</function-signature>
  </function>
  <function>
    <description>★★★★☆</description>
    <name>stars</name>
    <function-class>com.beautystation.util.Fmt</function-class>
    <function-signature>java.lang.String stars(double)</function-signature>
  </function>
  <function>
    <description>Noviembre 2026</description>
    <name>mesAnio</name>
    <function-class>com.beautystation.util.Fmt</function-class>
    <function-signature>java.lang.String mesAnio(java.time.YearMonth)</function-signature>
  </function>
  <function>
    <description>viernes, 20 de noviembre de 2026 (recibe yyyy-MM-dd)</description>
    <name>fechaLarga</name>
    <function-class>com.beautystation.util.Fmt</function-class>
    <function-signature>java.lang.String fechaLarga(java.lang.String)</function-signature>
  </function>
  <function>
    <description>Celdas de un mes para el calendario</description>
    <name>celdas</name>
    <function-class>com.beautystation.util.Fmt</function-class>
    <function-signature>java.util.List celdas(java.time.YearMonth, java.lang.String, java.util.Collection, boolean)</function-signature>
  </function>
</taglib>
